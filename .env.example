# =================================
# Backend API keys (preferred — not embedded in JS bundle)
# Use these in production to prevent key leakage into the app bundle
# =================================
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
TIINGO_API_KEY=
TWELVE_DATA_API_KEY=
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=
OPENROUTER_API_KEY=

# Legacy VITE_-prefixed keys (still work as fallback, but embed in JS bundle)
# Comment out the above and use these only for quick local development

# OpenRouter API Configuration
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
VITE_OPENROUTER_API_URL=https://openrouter.ai/api/v1

# Default LLM Model Configuration
# Options: anthropic/claude-3-sonnet, openai/gpt-4-turbo, meta-llama/llama-3-70b, etc.
VITE_DEFAULT_LLM_MODEL=anthropic/claude-3-sonnet-20240229

# Application Configuration
VITE_APP_NAME=Flowfolio
VITE_APP_VERSION=1.0.0

# Security
VITE_ENCRYPTION_ENABLED=true

# =================================
# MARKET DATA API KEYS (Optional)
# =================================
# The app uses multiple data sources with intelligent failover.
# Configure the ones you have access to for best results.

# Alpaca Markets (Free - Unlimited for basic data)
# Get your API key at: https://app.alpaca.markets/
VITE_ALPACA_API_KEY=your_alpaca_api_key_here
VITE_ALPACA_API_SECRET=your_alpaca_api_secret_here
VITE_ALPACA_PAPER_TRADING=true

# Finnhub (Free - 60 calls/min)
# Get your API key at: https://finnhub.io/
VITE_FINNHUB_API_KEY=your_finnhub_api_key_here

# Financial Modeling Prep (Free - 250 calls/day)
# Get your API key at: https://financialmodelingprep.com/
VITE_FMP_API_KEY=your_fmp_api_key_here

# Tiingo (Free - 500 calls/hour)
# Get your API key at: https://www.tiingo.com/
VITE_TIINGO_API_KEY=your_tiingo_api_key_here

# Twelve Data (Free - 800 calls/day)
# Get your API key at: https://twelvedata.com/
VITE_TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Polygon.io (Free - 5 calls/min)
# Get your API key at: https://polygon.io/
VITE_POLYGON_API_KEY=your_polygon_api_key_here

# Alpha Vantage (Free - 5 calls/min, 500/day)
# Get your API key at: https://www.alphavantage.co/
VITE_ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# Yahoo Finance (No API key required - used as fallback)

# Instagram caption style: 'professional' (clean, no AI tells) or 'default' (mixed formats)
CAPTION_STYLE=professional
