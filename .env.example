# =================================
# Backend API keys (preferred — not embedded in JS bundle)
# Use these in production to prevent key leakage into the app bundle
# =================================
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
TIINGO_API_KEY=
TWELVE_DATA_API_KEY=
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=
OPENROUTER_API_KEY=

# Frontend / UI configuration (safe to embed in JS bundle — not secrets)
VITE_APP_NAME=Flowfolio
VITE_APP_VERSION=1.0.0
# DEPRECATED — AI model is now configured in Settings → AI Model.
# VITE_DEFAULT_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Alpaca paper-trading flag (not a secret)
ALPACA_PAPER_TRADING=true

# =================================
# MARKET DATA API KEYS (Optional)
# =================================
# The app uses multiple data sources with intelligent failover.
# Configure the ones you have access to for best results.

# Alpaca Markets (Free - Unlimited for basic data)
# Get your API key at: https://app.alpaca.markets/

# Finnhub (Free - 60 calls/min)
# Get your API key at: https://finnhub.io/

# Financial Modeling Prep (Free - 250 calls/day)
# Get your API key at: https://financialmodelingprep.com/

# Tiingo (Free - 500 calls/hour)
# Get your API key at: https://www.tiingo.com/

# Twelve Data (Free - 800 calls/day)
# Get your API key at: https://twelvedata.com/

# Polygon.io (Free - 5 calls/min)
# Get your API key at: https://polygon.io/

# Alpha Vantage (Free - 5 calls/min, 500/day)
# Get your API key at: https://www.alphavantage.co/

# Yahoo Finance (No API key required - used as fallback)

# Instagram caption style: 'professional' (clean, no AI tells) or 'default' (mixed formats)
CAPTION_STYLE=professional
