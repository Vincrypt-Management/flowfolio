{
  "name": "flowfolio",
  "private": false,
  "version": "0.4.9",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "dev:landing": "vite --config vite.landing.config.ts",
    "build": "tsc && vite build",
    "build:landing": "vite build --config vite.landing.config.ts",
    "preview": "vite preview",
    "preview:landing": "vite preview --config vite.landing.config.ts --outDir dist-landing",
    "tauri": "tauri",
    "lint": "tsc --noEmit && eslint src/",
    "lint:fix": "eslint src/ --fix && prettier --write src/",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "setup:ui": "cd vendor/flowfolio-design-library && npm install && npm run build"
  },
  "dependencies": {
    "@flowfolio/ui": "file:vendor/flowfolio-design-library",
    "@tanstack/react-virtual": "^3.13.6",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-deep-link": "^2.4.7",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-stronghold": "^2.3.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.576.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@remotion/cli": "^4.0.428",
    "@remotion/media": "^4.0.429",
    "@remotion/media-utils": "^4.0.429",
    "@remotion/player": "^4.0.428",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.7",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "remotion": "^4.0.428",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.0.4",
    "vitest": "^4.0.18"
  }
}
