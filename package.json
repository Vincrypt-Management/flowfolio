{
  "name": "flowfolio",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "dev:landing": "vite --config vite.landing.config.ts",
    "build": "tsc && vite build",
    "build:landing": "vite build --config vite.landing.config.ts",
    "preview": "vite preview",
    "preview:landing": "vite preview --config vite.landing.config.ts --outDir dist-landing",
    "tauri": "tauri",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "remotion:preview": "npx remotion studio src/remotion/index.ts",
    "remotion:vo": "node src/remotion/scripts/generate-vo.mjs",
    "remotion:render:intro": "npx remotion render src/remotion/index.ts FlowFolioIntro out/flowfolio-intro.mp4",
    "remotion:render:intro-ig": "npx remotion render src/remotion/index.ts FlowFolioIntroIG out/flowfolio-intro-ig.mp4",
    "remotion:render:demo": "npx remotion render src/remotion/index.ts FlowFolioShowcase out/flowfolio-demo.mp4",
    "remotion:render:demo-ig": "npx remotion render src/remotion/index.ts FlowFolioShowcaseIG out/flowfolio-demo-ig.mp4",
    "remotion:render:app": "npx remotion render src/remotion/index.ts FlowFolioAppShowcase out/flowfolio-app-showcase.mp4",
    "remotion:render:release022": "npx remotion render src/remotion/index.ts FlowFolioRelease022 out/flowfolio-release-022.mp4",
    "remotion:render": "npm run remotion:render:intro && npm run remotion:render:intro-ig && npm run remotion:render:demo && npm run remotion:render:demo-ig && npm run remotion:render:app",
    "ig:render": "npx tsx scripts/instagram/render/generate.ts",
    "ig:render:pending": "npx tsx scripts/instagram/render/generate.ts --all-pending",
    "ig:render:single": "npx tsx scripts/instagram/render/generate.ts --post-id",
    "ig:pipeline": "npx tsx scripts/instagram/pipeline.ts",
    "ig:post": "npx tsx scripts/instagram/pipeline.ts --skip-render --video intro-ig",
    "ig:post:all": "npx tsx scripts/instagram/pipeline.ts --all",
    "ig:signup": "npx tsx scripts/instagram/pipeline.ts --signup --video intro-ig",
    "ig:schedule:plan": "npx tsx scripts/instagram/scheduler.ts plan",
    "ig:schedule:plan:growth": "npx tsx scripts/instagram/scheduler.ts plan --profile growth",
    "ig:schedule:plan:daily": "npx tsx scripts/instagram/scheduler.ts plan --profile daily",
    "ig:schedule:render": "npx tsx scripts/instagram/scheduler.ts render",
    "ig:schedule:run": "npx tsx scripts/instagram/scheduler.ts run",
    "ig:schedule:status": "npx tsx scripts/instagram/scheduler.ts status",
    "ig:schedule:list": "npx tsx scripts/instagram/scheduler.ts list",
    "ig:schedule:clear": "npx tsx scripts/instagram/scheduler.ts clear"
  },
  "dependencies": {
    "@playwright/test": "^1.58.2",
    "@remotion/cli": "^4.0.428",
    "@remotion/media": "^4.0.429",
    "@remotion/media-utils": "^4.0.429",
    "@remotion/player": "^4.0.428",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2.4.7",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-opener": "^2",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.6.2",
    "dotenv-cli": "^11.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.576.0",
    "playwright": "^1.58.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.6.0",
    "remotion": "^4.0.428"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "dotenv": "^17.3.1",
    "jsdom": "^28.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.0.18"
  }
}
