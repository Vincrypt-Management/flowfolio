# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/flowfolio

# ── JWT ───────────────────────────────────────────────────────────────────────
# Secret used to sign and verify access + refresh tokens (min 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret-value

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redirect URI registered in Google Cloud Console — must match exactly
# e.g. http://localhost:3001/auth/google/callback for local dev
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Full public URL this server is reachable at (used to build OAuth redirect URI)
SERVER_URL=http://localhost:3001

# Deep-link URL the Tauri app registers to receive OAuth tokens after login
# Must match the custom scheme registered in tauri.conf.json
APP_CALLBACK_URL=flowfolio://auth/callback

# ── Stripe ────────────────────────────────────────────────────────────────────
# Secret key from Stripe dashboard (use sk_test_... for development)
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — copy from Stripe dashboard or `stripe listen` output
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs for each plan — create these in the Stripe dashboard
STRIPE_AI_MONTHLY_PRICE_ID=price_...
STRIPE_AI_ANNUAL_PRICE_ID=price_...
STRIPE_SYNC_MONTHLY_PRICE_ID=price_...
STRIPE_SYNC_ANNUAL_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...

# Base URL of the frontend app — used for checkout success/cancel redirects
APP_URL=http://localhost:1420

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# CORS allowed origin — Tauri webview default is http://localhost:1420
# In production, restrict this to your app's origin
CORS_ORIGIN=http://localhost:1420
