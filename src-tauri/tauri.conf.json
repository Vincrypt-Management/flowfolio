{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowFolio",
  "version": "0.4.2",
  "identifier": "com.evintleovonzko.flowfolio",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FlowFolio - AI-Powered Vibe-Based Investing",
        "width": 1200,
        "height": 800,
        "minWidth": 375,
        "minHeight": 667
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: https://*.openrouter.ai https://*.alphavantage.co https://*.finnhub.io https://*.yahoo.com https://*.duckduckgo.com https://*.tavily.com https://*.brave.com https://*.alpaca.markets; object-src 'none'; base-uri 'self'; form-action 'self';"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["flowfolio"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "developmentTeam": "",
      "minimumSystemVersion": "14.0"
    },
    "resources": []
  }
}
